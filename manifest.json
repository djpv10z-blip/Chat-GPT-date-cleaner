{
  "manifest_version": 3,
  "name": "ChatGPT Date Cleaner",
  "version": "1.2.1",
  "description": "Review and manage older ChatGPT conversations by date; multilingual interface, CSV export and confirmation safeguards. Unofficial beta.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "locales.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
