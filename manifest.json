
{
  "manifest_version": 3,
  "name": "ChatGPT Date Cleaner",
  "version": "1.2.0",
  "description": "Gestione multilingue delle conversazioni per data con anteprima CSV, finestra mobile e conferme di sicurezza.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["locales.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
